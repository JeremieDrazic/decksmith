# NODE_OPTIONS injected by Claude Code (cmux) points to a temp file that doesn't survive
# into subprocesses — unset it so Node.js in lint/format tools starts clean.
unset NODE_OPTIONS

# Hooks never have a TTY — tell pnpm to skip interactive prompts (e.g. modules purge confirmation).
export CI=true

# Format staged files with oxfmt
pnpm lint-staged

# Auto-fix lint issues across the repo (turbo caching makes this fast)
pnpm turbo run lint -- --fix

# Re-stage any files that were auto-fixed
git add -u
